<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".PortariaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastro de encomenda"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informe a unidade que receberá a encomenda."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bloco"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerBlock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apartamento"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerApartment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Morador"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textResident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecione um apartamento"
            android:textSize="16sp"
            android:textColor="#666666"
            android:padding="12dp"
            android:background="#F1F3F4"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrição da encomenda"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex.: Caixa, envelope, pacote..."
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="100dp"
            android:gravity="top|start"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonRegisterParcel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar encomenda" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DADCE0"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Encomendas pendentes"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Encomendas que ainda aguardam retirada."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonRefreshParcels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atualizar lista" />

        <TextView
            android:id="@+id/textPendingEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando encomendas..."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:padding="16dp" />

        <LinearLayout
            android:id="@+id/pendingParcelsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DADCE0"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Histórico de encomendas"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulte as encomendas que já foram retiradas."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonRefreshHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atualizar histórico" />

        <TextView
            android:id="@+id/textHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando histórico..."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:padding="16dp" />

        <LinearLayout
            android:id="@+id/historyParcelsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>